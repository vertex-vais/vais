# Nur für lokalen Betrieb: Kopiere diese Datei zu ".env".
# Online (Render) werden dieselben Werte als Umgebungsvariablen eingetragen.

PORT=3000

# Auf "true" setzen, sobald die Seite über https läuft (sichere Cookies)
COOKIE_SECURE=false

# ── KI-Modelle (OpenRouter) ───────────────────────────────────────
# Kostenloser Schlüssel von openrouter.ai/keys. Leer lassen = Demo-Modus.
OPENROUTER_API_KEY=
# Google Gemini/Gemma kostenlos: aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq kostenlos (gpt-oss, Llama, Qwen, Kimi, Websuche): console.groq.com/keys
GROQ_API_KEY=
# Cerebras (braucht inzwischen eine Zahlungsmethode) (gpt-oss, Llama, Qwen, GLM): cloud.cerebras.ai
CEREBRAS_API_KEY=
# Mistral kostenlos (Plan „Experiment“): console.mistral.ai
MISTRAL_API_KEY=
# Bilder: funktionieren ohne Schlüssel (Pollinations). Mit kostenlosem Konto auf enter.pollinations.ai mehr Modelle:
# Kostenloser Schlüssel von enter.pollinations.ai – nötig für die Online-Stimme (Vorlesen/Sprach-Modus), gibt auch mehr Bildmodelle
POLLINATIONS_API_KEY=
# Bild-Modus ganz abschalten: DISABLE_FREE_IMAGES=true
# Optional, kostet Guthaben: zusätzliche OpenRouter-Modelle, durch Komma getrennt
OPENROUTER_EXTRA_MODELS=
# Premium-Antworten pro Nutzer und Tag (Standard 20)
PAID_DAILY_LIMIT=20

# ── Datenbank (Turso) ─────────────────────────────────────────────
# Leer lassen = lokale Datei data/vais.db
DATABASE_URL=
DATABASE_TOKEN=

# ── E-Mail-Versand ────────────────────────────────────────────────
# Einfachster Weg: Brevo-API-Schlüssel (beginnt mit xkeysib-). Dann wird SMTP nicht gebraucht.
BREVO_API_KEY=

# Alternativ SMTP (z. B. Brevo):
# Leer lassen = Entwicklungsmodus: Der Code erscheint nur in der Konsole.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Apex <deine-adresse@gmail.com>"

# Betreiber für Impressum/Datenschutz (Standard: Leeam Thiemann) und Admin-Konten
# OWNER_NAME=
# OWNER_EMAIL=
# IMPRESSUM_ADDRESS=Musterstraße 1, 12345 Musterstadt
# ADMIN_EMAILS=leeam.thiemann18@gmail.com

# ── Cursor-API-Keys (Admin-Bereich) ───────────────────────────────
# Optionaler Ersatz, wenn im Admin kein aktiver Schlüssel dieses Anbieters frei ist.
# Im Admin gespeicherte Schlüssel haben Vorrang und liegen verschlüsselt in der Datenbank.
CURSOR_API_KEY=
# NVIDIA NIM (build.nvidia.com), OpenAI-kompatibel: https://integrate.api.nvidia.com/v1
# Kostenloses Kontingent: nur für Admins, nie für Anfragen normaler Nutzer.
NVIDIA_API_KEY=
# GitHub Models (https://models.github.ai/inference)
GITHUB_MODELS_TOKEN=
# Optional, Benutzerdefiniert (OpenAI-kompatibel), nur als Ersatz ohne Eintrag im Admin
# CUSTOM_OPENAI_API_KEY=
# CUSTOM_OPENAI_BASE_URL=
# CUSTOM_OPENAI_MODEL=
# Verschlüsselt die im Admin gespeicherten Cursor-Keys (AES-256-GCM).
# Langer Zufallswert, z. B. openssl rand -base64 32. Unbedingt setzen,
# bevor Keys gespeichert werden. Fehlt die Variable, leitet der Server
# den Schlüssel aus DATABASE_TOKEN ab, sonst aus SMTP_PASS, sonst aus
# BREVO_API_KEY, sonst aus GOOGLE_CLIENT_SECRET, und schreibt eine Warnung.
# Ohne jedes dieser Geheimnisse gilt nur ein lokaler Ersatz – nicht für
# Produktion. Ein späterer Wechsel macht gespeicherte Keys unlesbar;
# dann im Admin neu eintragen.
KEY_ENCRYPTION_SECRET=
